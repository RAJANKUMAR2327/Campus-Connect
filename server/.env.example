NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus-connect
JWT_SECRET=replace-with-a-long-random-development-secret
ANON_SALT=replace-with-a-different-long-random-string # used only to anonymize confession authors — deliberately separate from JWT_SECRET, do not reuse the same value
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=CampusConnect <your-email@gmail.com>

ALLOWED_DOMAINS=* # comma-separated email domains allowed to register (e.g. college.edu,alumni.college.edu). * = no restriction, any domain can register.

# Comma-separated, EXACT origins allowed to call the API / connect via Socket.IO
# with credentials. Do not use a wildcard suffix like "*.vercel.app" in production —
# that trusts every app hosted on Vercel, not just yours.
ALLOWED_ORIGINS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

VAPID_PUBLIC_KEY=generate-with-web-push-cli
VAPID_PRIVATE_KEY=generate-with-web-push-cli
VAPID_EMAIL=mailto:you@example.com

# Required for the AI Tools features (server/controllers/aiController.js).
# Despite the README/product name mentioning Claude, the code currently
# calls Google Gemini — this is the key it actually reads.
GEMINI_API_KEY=your-gemini-api-key

